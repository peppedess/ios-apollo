From 06329c7f8091a3accbdcf70b6c3ff00610279a28 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 15:51:37 +0100
Subject: [PATCH] apollo pcie: sweetwmimin=1 sends a minimal resource config,
 to tell a resource assert from a missing setup

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VzhH6pxBJ4naMiihKoMfcq
---
 bsd/dev/apollo_pcie.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/bsd/dev/apollo_pcie.c b/bsd/dev/apollo_pcie.c
index 11e3d9e..ad28e1a 100644
--- a/bsd/dev/apollo_pcie.c
+++ b/bsd/dev/apollo_pcie.c
@@ -1457,6 +1457,29 @@ wmi_init(void)
 	RC(0, (0x4fu << 16) | 288u);
 	uint32_t chains = g_htc.rf_chains ? g_htc.rf_chains : 2u;
 	uint32_t mask = (1u << chains) - 1u;
+	/*
+	 * k13b: the firmware asserts in cmnos_thread.c line 502 right after INIT, which reads like it ran out of
+	 * threads or heap. sweetwmimin=1 asks for the smallest sensible target: one vdev, four peers, no TDLS, no
+	 * WoW, no offloads. If it still asserts the same way, the config is not what the firmware is missing.
+	 */
+	uint32_t minimal = 0;
+	(void)PE_parse_boot_argn("sweetwmimin", &minimal, sizeof(minimal));
+	if (minimal) {
+		RC(1, 1); RC(2, 4); RC(6, 8); RC(7, 16); RC(8, mask); RC(9, mask);
+		RC(10, 100); RC(11, 100); RC(12, 100); RC(13, 40);
+		RC(14, 1); RC(15, 4); RC(22, 1024); RC(29, 64); RC(30, 6);
+		RC(33, 1); RC(44, 1u << 5); RC(54, 1); RC(67, 1u << 9);
+		printf("SWEET WMI: INIT minimal (1 vdev, 4 peers, 8 tids)\n");
+		htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)msg, sizeof(msg));
+		if (wifi_wait(&g_htc.wmi_ready, 10000, "WMI ready") != 0) {
+			return;
+		}
+		printf("SWEET WMI: FIRMWARE UP (WMI ready)\n");
+		if (g_step >= 15) {
+			wifi_scan();
+		}
+		return;
+	}
 	RC(1, 3);                                                       /* num_vdevs (2 + 1) */
 	RC(2, 16);                                                      /* num_peers */
 	RC(3, 3);                                                       /* num_offload_peers */
-- 
2.43.0

