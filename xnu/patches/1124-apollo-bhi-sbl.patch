From 638532c8083866bafefc063dd4b4913b09d58384 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 14:16:01 +0100
Subject: [PATCH] apollo pcie: phase 2b, BHI download of the QCA6390 SBL (head
 of amss20.bin from /chosen/wlanfw)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VzhH6pxBJ4naMiihKoMfcq
---
 bsd/dev/apollo_pcie.c | 96 ++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 95 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/apollo_pcie.c b/bsd/dev/apollo_pcie.c
index 28ea34a..cef6cb3 100644
--- a/bsd/dev/apollo_pcie.c
+++ b/bsd/dev/apollo_pcie.c
@@ -1,7 +1,7 @@
 /*
  * apollo (Xiaomi 10T Pro, kona/SM8250): PCIe root complex 0 bring-up for the QCA6390 Wi-Fi chip,
  * phase 1 of docs/apollo/wifi-plan.md: power, clocks, PHY, link training, one config read of the
- * endpoint (expect 17cb:1101); step 7 (phase 2a): BAR0 and a read-only MHI/BHI dump. Off unless boot-arg sweetpcie=1; everything is logged as "SWEET PCIE:".
+ * endpoint (expect 17cb:1101); step 7 (phase 2a): BAR0 and a read-only MHI/BHI dump; step 8 (2b): BHI download of the SBL. Off unless boot-arg sweetpcie=1; everything is logged as "SWEET PCIE:".
  *
  * Sources: the live DT (qcom,pcie@1c00000 "qcom,pci-msm", qcom,cnss-qca6390@b0000000), Linux 6.12
  * drivers/pci/controller/dwc/pcie-qcom.c (init_2_7_0, ops_1_9_0 used for sm8250), pcie-designware.h,
@@ -23,10 +23,16 @@
 #include <kern/clock.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <mach/mach_time.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
 extern void IOSleep(unsigned int milliseconds);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 extern int sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
 void apollo_pcie_init(void);
 
@@ -179,6 +185,90 @@ mhi_ee_name(uint32_t ee)
 	return ee < 8 ? n[ee] : "?";
 }
 
+/*
+ * Wi-Fi phase 2b: the PBL takes the SBL over BHI (Linux drivers/bus/mhi/host/boot.c mhi_fw_load_bhi, ath11k
+ * sbl_size 512 KiB = the head of amss20.bin): image in physically contiguous memory below 4 GiB (ath11k's
+ * 32-bit DMA mask), IMGADDR/IMGSIZE, then a session id in IMGTXDB; BHI_STATUS bits 31:30 = 2 is success,
+ * 3 error (ERRCODE/ERRDBG tell why). Afterwards the execution environment should move from PBL to SBL.
+ * The device reaches this memory at its physical address only if the apps SMMU passes stream 0x1c00 through;
+ * a failure here with an error code points at that.
+ */
+#define SBL_SIZE        0x80000u
+static uint32_t g_step = 0xff;
+
+static const uint8_t *
+wlan_firmware(const char *name, uint32_t *len)
+{
+	DTEntry chosen;
+	void const *data;
+	unsigned size;
+	char prop[40];
+	snprintf(prop, sizeof(prop), "wlanfw,%s", name);
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, prop, &data, &size) != kSuccess) {
+		printf("SWEET MHI: no %s in the device tree (mkpayload.py --wlanfw)\n", prop);
+		return NULL;
+	}
+	*len = size;
+	return data;
+}
+
+static void
+bhi_load_sbl(uint32_t bhi)
+{
+	uint32_t fwlen = 0;
+	const uint8_t *fw = wlan_firmware("amss20.bin", &fwlen);
+	if (!fw) {
+		return;
+	}
+	uint32_t len = fwlen < SBL_SIZE ? fwlen : SBL_SIZE;
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, SBL_SIZE, PAGE_MASK, (ppnum_t)(atop_64(0x100000000ull) - 1), 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET MHI: no contiguous memory for the SBL\n");
+		return;
+	}
+	uint64_t pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)va));
+	memcpy((void *)va, fw, len);
+	flush_dcache64((addr64_t)va, SBL_SIZE, FALSE);
+	printf("SWEET MHI: amss20.bin %u bytes (head %02x%02x%02x%02x), SBL %u bytes at pa %#llx\n", fwlen, fw[0],
+	    fw[1], fw[2], fw[3], len, pa);
+	if (pa + SBL_SIZE > 0x100000000ull) {
+		printf("SWEET MHI: SBL above 4 GiB, not loading\n");
+		return;
+	}
+	wr(g_bar, bhi + 0x20, 0);                                       /* INTVEC: MSI vector 0 (we poll) */
+	wr(g_bar, bhi + 0x0c, (uint32_t)(pa >> 32));                    /* IMGADDR_HIGH */
+	wr(g_bar, bhi + 0x08, (uint32_t)pa);                            /* IMGADDR_LOW */
+	wr(g_bar, bhi + 0x10, len);                                     /* IMGSIZE */
+	uint32_t session = (uint32_t)(mach_absolute_time() & 0x3fffffffu) | 1u;
+	wr(g_bar, bhi + 0x18, session);                                 /* IMGTXDB */
+	uint32_t st = 0;
+	int ms;
+	for (ms = 0; ms < 2000; ms += 5) {
+		st = rd(g_bar, bhi + 0x2c) >> 30;
+		if (st == 2u || st == 3u) {
+			break;
+		}
+		pc_msleep(5);
+	}
+	printf("SWEET MHI: BHI %s after %d ms: status %#x err %#x dbg %x %x %x, ee %u\n",
+	    st == 2u ? "SUCCESS" : st == 3u ? "ERROR" : "timeout", ms, rd(g_bar, bhi + 0x2c), rd(g_bar, bhi + 0x30),
+	    rd(g_bar, bhi + 0x34), rd(g_bar, bhi + 0x38), rd(g_bar, bhi + 0x3c), rd(g_bar, bhi + 0x28));
+	/* where it goes next: SBL waits for the BHIe image (phase 2c); watch the EE and MHI state for 3 s */
+	uint32_t last = 0xffffffffu;
+	for (ms = 0; ms <= 3000; ms += 50) {
+		uint32_t now = (rd(g_bar, bhi + 0x28) << 16) | ((rd(g_bar, 0x48) >> 8) & 0xffu) | (rd(g_bar, 0x48) & 4u) << 6;
+		if (now != last) {
+			uint32_t e = now >> 16;
+			printf("SWEET MHI: +%d ms ee %u (%s) mhi state %u syserr %u bhie-status %x\n", ms, e, mhi_ee_name(e),
+			    now & 0xffu, (now >> 8) & 1u, rd(g_bar, 0x224 + 0x2c));
+			last = now;
+		}
+		pc_msleep(50);
+	}
+}
+
 static void
 mhi_probe(void)
 {
@@ -241,6 +331,9 @@ mhi_probe(void)
 	printf("SWEET MHI: serial %#x sbl-arb %#x numseg %u hwid %x %x %x %x\n", rd(g_bar, bhi + 0x40),
 	    rd(g_bar, bhi + 0x44), rd(g_bar, bhi + 0x48), rd(g_bar, bhi + 0x4c), rd(g_bar, bhi + 0x50),
 	    rd(g_bar, bhi + 0x54), rd(g_bar, bhi + 0x58));
+	if (ee == 0 && g_step >= 8) {
+		bhi_load_sbl(bhi);
+	}
 }
 
 static void
@@ -248,6 +341,7 @@ pcie_main(void *arg __unused, wait_result_t w __unused)
 {
 	uint32_t step = 0xff;
 	(void)PE_parse_boot_argn("sweetpciestep", &step, sizeof(step));
+	g_step = step;
 	printf("SWEET PCIE: start (sweetpciestep=%u)\n", step);
 
 	/* 1. power: the RC's PHY rails, the QCA6390's rails, then WLAN_EN (cnss: rails, 10 ms, WLAN_EN, 100 ms) */
-- 
2.43.0

