+		(void)wifi_wait(&never, (int)idle * 1000, "idle");
+		printf("SWEET WMI: after %u s idle: %s\n", idle, g_sysfail ? "FIRMWARE DEAD" : "firmware alive");
+		if (g_sysfail) {
+			return;
+		}
+	}
 	uint32_t minimal = 0;
 	(void)PE_parse_boot_argn("sweetwmimin", &minimal, sizeof(minimal));
 	if (minimal) {
 		RC(1, 1); RC(2, 4); RC(6, 8); RC(7, 16); RC(8, mask); RC(9, mask);
 		RC(10, 100); RC(11, 100); RC(12, 100); RC(13, 40);
 		RC(14, 1); RC(15, 4); RC(22, 1024); RC(29, 64); RC(30, 6);
-		RC(33, 1); RC(44, 1u << 5); RC(54, 1); RC(67, 1u << 9);
+		RC(33, 1); RC(44, 1u << 5); RC(54, 1); RC(68, 1u << 9);
 		printf("SWEET WMI: INIT minimal (1 vdev, 4 peers, 8 tids)\n");
 		htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)msg, sizeof(msg));
 		if (wifi_wait(&g_htc.wmi_ready, 10000, "WMI ready") != 0) {
@@ -1506,7 +1758,7 @@ wmi_init(void)
 	RC(35, 0x16);                                                   /* num_wow_filters */
 	RC(44, 1u << 5);                                                /* flag1: BSS_CHANNEL_INFO_64 */
 	RC(54, 1);                                                      /* use_pdev_id */
-	RC(67, 1u << 9);                                                /* flags2: CALC_NEXT_DTIM_COUNT_SET */
+	RC(68, 1u << 9);                                                /* flags2: CALC_NEXT_DTIM_COUNT_SET */
 	cfg[73] = (0x13u << 16);                                        /* ARRAY_STRUCT, no memory chunks */
 	printf("SWEET WMI: INIT (%u bytes, %u chains, mask %#x): vdevs %u peers %u tids %u msdu %u frag %u wow %u pdev_id %u\n",
 	    (unsigned)sizeof(msg), chains, mask, cfg[1], cfg[2], cfg[6], cfg[29], cfg[30], cfg[35], cfg[54]);
@@ -1624,6 +1876,15 @@ wifi_start(void)
 		(void)wifi_wait(&never, 3000, "listening");
 		return;
 	}
+	uint32_t dp = 0;
+	(void)PE_parse_boot_argn("sweetdp", &dp, sizeof(dp));
+	if (dp) {
+		wifi_dp();
+		if (g_sysfail) {
+			printf("SWEET DP: the firmware died while the rings were being built\n");
+			return;
+		}
+	}
 	wmi_init();
