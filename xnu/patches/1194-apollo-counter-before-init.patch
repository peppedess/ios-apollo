+		uint32_t pwr = 1;
+		(void)PE_parse_boot_argn("sweetpwr", &pwr, sizeof(pwr));
+		if (pwr) {
+		/*
+		 * Measure WLAON's own counter against ours. GLOBAL_COUNTER_CTRL5 (0x1f80120) is the enable
+		 * — 0 clears, 0x80000000 runs — and CTRL3/CTRL4 (0x1f80118/0x1f8011c) are the low and high
+		 * halves, exactly as cnss_pci_get_device_timestamp reads them. The firmware told us in the
+		 * capability response what rate it expects; sample the counter across 100 ms of our own time
+		 * and compare. The GDSC power-down handshake is timed in WLAON, by this clock, and the
+		 * firmware's poll gives it about twenty milliseconds. A counter running slow by a large
+		 * factor would make a handshake that normally takes microseconds overrun that budget, which
+		 * is the shape of what k17 showed: nothing for 55 ms, one state step, then the assert.
+		 */
+		win_wr(0x1f80120, 0);
+		win_wr(0x1f80120, 0x80000000u);
+		uint32_t c0lo = win_rd(0x1f80118), c0hi = win_rd(0x1f8011c);
+		pc_msleep(100);
+		uint32_t c1lo = win_rd(0x1f80118), c1hi = win_rd(0x1f8011c);
+		uint64_t t0 = ((uint64_t)c0hi << 32) | c0lo, t1 = ((uint64_t)c1hi << 32) | c1lo;
+		printf("SWEET PWR: WLAON counter %llu -> %llu in 100 ms = %llu Hz, firmware expects %u Hz\n",
+		    t0, t1, (t1 - t0) * 10ull, g_timefreq);
+		printf("SWEET PWR: RTC cal %#x %#x %#x %#x %#x %#x %#x %#x %#x\n",
