+/*
+ * A staircase, because k116 left no evidence. Its log stops at 71.1 s, before wifi_dp has printed even
+ * its first line, and contains not one SWEET DP or SWEET HTT line — the same signature as the runs that
+ * overflowed the HTC buffer, where the kernel stayed alive to its scheduled reboot while the log flush
+ * quietly died. k111 ran the same wifi_dp with sweetdp=1 and logged all of it, so the difference is in
+ * here somewhere. sweetlmac walks it in steps: 0 skips everything, 1 allocates the rings, 2 also fills
+ * the refill ring with buffers, 3 also hands the rings to the firmware. Whichever step kills the log is
+ * the one to look at. Each step says so before it does anything, so the last line standing names it.
+ */
+static uint32_t
+lmac_step(void)
+{
+	/*
+	 * Folded into sweetdp rather than given an argument of its own, because the boot-args line is 592
+	 * bytes and a second name does not fit beside the rest. sweetdp=1 is what it has always been, the
+	 * UMAC rings alone; 2 also allocates the LMAC rings, 3 also fills the refill ring, 4 also hands them
+	 * to the firmware.
+	 */
+	uint32_t dp = 0;
+	(void)PE_parse_boot_argn("sweetdp", &dp, sizeof(dp));
+	return dp > 1u ? dp - 1u : 0u;
+}
+
 static void
 dp_lmac_rings(void)
 {
