+/*
+ * Whether sweetfwlog asked for the firmware's log at all. Read once, where both the printer and the
+ * drain before the sweep can see it.
+ */
+static int
+fwlog_wanted(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		uint32_t v = 0;
+		(void)PE_parse_boot_argn("sweetfwlog", &v, sizeof(v));
+		on = v ? 1 : 0;
+	}
+	return on;
+}
