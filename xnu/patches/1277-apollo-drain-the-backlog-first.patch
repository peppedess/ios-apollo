+/*
+ * Harmless work, in quantity, to make the firmware ship its log. Each write sets the pdev's dynamic
+ * bandwidth to the value it already has; the firmware parses, dispatches and annotates every one of
+ * them, and the ring fills and goes out. The pause every thirty-two commands lets the HTC credits
+ * come back so none of them is dropped.
+ */
+static void
+wifi_fwlog_churn(uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		wifi_pdev_param(0x0a, 1);
+		if ((i & 31u) == 31u) {
+			(void)er0_poll();
+			(void)er1_poll();
+			ce_poll();
+			pc_msleep(10);
+		}
+	}
+}
