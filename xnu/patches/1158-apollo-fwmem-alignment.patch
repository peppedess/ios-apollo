+			pa = (raw + align - 1) & ~(align - 1);
+			if (pa + size > 0x100000000ull) {
+				printf("SWEET WLFW: segment %u: %u bytes type %u: above 4 GiB\n", i, size, type);
+				fail = 1;
+				continue;
+			}
+			vm_offset_t va = ml_io_map((vm_offset_t)pa, span);
 			for (uint32_t z = 0; va && z < size; z += 4) {
