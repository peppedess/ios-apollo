diff --git a/bsd/dev/apollo_pcie.c b/bsd/dev/apollo_pcie.c
index 67946d7..88089e0 100644
--- a/bsd/dev/apollo_pcie.c
+++ b/bsd/dev/apollo_pcie.c
@@ -2132,7 +2132,31 @@ wmi_init(void)
 		 * block at BAR + 0x48, which is always accessible and needs no wake vote, so polling it is the one
 		 * probe that tells us when the firmware actually dies without being the reason it dies.
 		 */
+		/*
+		 * And watch the power state machine itself. cnss2's register map gives us the piece we were
+		 * missing: QCA6390_WCSS_WFSS_PMM_WFSS_PMM_R0_PMM_CTRL is 0x00b60164 for the host, and the
+		 * firmware's own name for that register is WFSS_PMM_R0 at 0xe0b60164. The two views are the same
+		 * block with the top nibble swapped, so every address the firmware touches in its power sequence
+		 * has a host address we can read: 0xe0c300c4, the WLAN1 GDSCR it dies polling, is 0x00c300c4 here.
+		 *
+		 * WCSS itself is unsafe to read while its clocks are off — k13n hung the phone on 0xc30004 — but
+		 * WLAON is the always-on domain and is exactly where the host-visible mirrors live:
+		 * WL_PWR_STATUS_REG and the two WCSS_TCSR_PMM_SR_STATUS halves, which the stock driver reads in
+		 * its own crash dump. Poll those three alongside MHISTATUS and print every change. For the first
+		 * time this gives a direct timeline of the power sequence across the 80 ms instead of the
+		 * inference we have been working from. sweetpwr=0 goes back to MHISTATUS alone.
+		 */
+		uint32_t pwr = 1;
+		(void)PE_parse_boot_argn("sweetpwr", &pwr, sizeof(pwr));
+		if (pwr) {
+			printf("SWEET PWR: WLAON soc_power_ctrl %#x wl_pwr_status %#x pmm_sr_lo %#x pmm_sr_hi %#x "
+			    "gdsc_delay %#x/%#x rfa_mem_slp %#x wcssaon_cfg %#x clk_kdf %#x clk_hfrc %#x\n",
+			    win_rd(0x1f80000), win_rd(0x1f8002c), win_rd(0x1f806d0), win_rd(0x1f806cc),
+			    win_rd(0x1f80024), win_rd(0x1f80028), win_rd(0x1f8001c), win_rd(0x1f80300),
+			    win_rd(0x1f80314), win_rd(0x1f80318));
+		}
 		uint32_t st = 0, first = 0;
+		uint32_t lp = 0xffffffffu, llo = 0xffffffffu, lhi = 0xffffffffu;
 		printf("SWEET WMI: quiet window, %u ms watching MHISTATUS only\n", quiet);
 		for (uint32_t ms = 0; ms < quiet; ms += 5) {
 			st = rd(g_bar, 0x48);
@@ -2140,6 +2164,13 @@ wmi_init(void)
 				first = 1;
 				printf("SWEET MHI: SYSERR in mhistatus %#x at +%u ms after INIT\n", st, ms);
 			}
+			if (pwr && ms <= 200u) {
+				uint32_t p = win_rd(0x1f8002c), lo = win_rd(0x1f806d0), hi = win_rd(0x1f806cc);
+				if (p != lp || lo != llo || hi != lhi) {
+					printf("SWEET PWR: +%u ms wl_pwr_status %#x pmm_sr %#x:%#x\n", ms, p, hi, lo);
+					lp = p; llo = lo; lhi = hi;
+				}
+			}
 			pc_msleep(5);
 		}
 		if (!first) {
