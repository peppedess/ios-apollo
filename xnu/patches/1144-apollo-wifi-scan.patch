From 296ee4a729c56f9b4c6d3fa299ca5c985643a377 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 01:13:18 +0100
Subject: [PATCH] apollo pcie: Wi-Fi phase 4c, station vdev and scan, log every
 beacon/probe response

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01VzhH6pxBJ4naMiihKoMfcq
---
 bsd/dev/apollo_pcie.c | 124 +++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 121 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/apollo_pcie.c b/bsd/dev/apollo_pcie.c
index 35c5e8a..b5b2644 100644
--- a/bsd/dev/apollo_pcie.c
+++ b/bsd/dev/apollo_pcie.c
@@ -952,6 +952,9 @@ static struct {
 	uint32_t wmi_eid, htt_eid;
 	volatile int svc_ready, wmi_ready;
 	uint32_t rf_chains, num_mem_reqs;
+	uint8_t mac[6];
+	volatile int scan_done;
+	uint32_t aps;
 } g_htc;
 
 static uint32_t
@@ -1095,8 +1098,44 @@ htc_rx(uint32_t pipe, const uint8_t *p, uint32_t n)
 			}
 			printf("SWEET WMI: READY: MAC %02x:%02x:%02x:%02x:%02x:%02x\n", mac[0], mac[1], mac[2], mac[3],
 			    mac[4], mac[5]);
+			memcpy(g_htc.mac, mac, 6);
 			g_htc.wmi_ready = 1;
 		}
+		if (m0 == 4u && n >= 16 + 8) {                          /* WMI_SCAN_EVENTID */
+			uint32_t ev, freq = 0;
+			memcpy(&ev, p + 16, 4);
+			if (n >= 16 + 12) {
+				memcpy(&freq, p + 16 + 8, 4);
+			}
+			printf("SWEET WMI: scan event %#x%s%s freq %u\n", ev, (ev & 1u) ? " STARTED" : "",
+			    (ev & 2u) ? " COMPLETED" : "", freq);
+			if (ev & 2u) {
+				g_htc.scan_done = 1;
+			}
+		}
+		if (m0 == 0x7001u && n >= 16 + 60) {                    /* WMI_MGMT_RX_EVENTID */
+			/* mgmt_rx_hdr: channel, snr, rate, phy_mode, buf_len, status, rssi_ctl[4], flags, rssi, ... */
+			uint32_t chan = 0, buflen = 0;
+			int32_t rssi = 0;
+			memcpy(&chan, p + 16, 4);
+			memcpy(&buflen, p + 16 + 16, 4);
+			memcpy(&rssi, p + 16 + 44, 4);
+			/* the frame follows the header TLV: 802.11 mgmt, SSID is the first IE after the 36-byte body */
+			const uint8_t *f = p + 16 + tlen + 4 + 4;
+			uint32_t avail = n > (uint32_t)(f - p) ? n - (uint32_t)(f - p) : 0;
+			char ssid[33] = { 0 };
+			uint8_t bss[6] = { 0 };
+			if (avail >= 38) {
+				uint32_t sub = (f[0] >> 4) & 0xfu;
+				memcpy(bss, f + 16, 6);
+				if ((sub == 8u || sub == 5u) && f[36] == 0 && f[37] <= 32 && avail >= 38u + f[37]) {
+					memcpy(ssid, f + 38, f[37]);
+				}
+			}
+			g_htc.aps++;
+			printf("SWEET WIFI: AP %02x:%02x:%02x:%02x:%02x:%02x \"%s\" channel %u rssi %d (%u bytes)\n", bss[0],
+			    bss[1], bss[2], bss[3], bss[4], bss[5], ssid, chan, rssi, buflen);
+		}
 		return;
 	}
 	printf("SWEET CE%u: rx %u bytes: HTC ep %u flags %#x len %u | %08x %08x", pipe, n, eid, flags, len, m0, m1);
@@ -1164,9 +1203,84 @@ ce_poll(void)
  * 32 bytes: ABI version zeroed, 0 memory chunks][RESOURCE_CONFIG tag 0x4f, 292 bytes][ARRAY_STRUCT tag 0x13,
  * empty]. single_pdev_only, so no hw-mode TLV. The answer is WMI_READY (event 2) with the adapter's MAC address.
  */
-#define RC(field, value)        cfg[field] = (value)
 static int wifi_wait(volatile int *flag, int timeout_ms, const char *what);
+static void wifi_scan(void);
 
+/*
+ * Wi-Fi phase 4c: a station vdev and a scan, as ath11k does (wmi.c ath11k_wmi_vdev_create and
+ * ath11k_wmi_send_scan_start_cmd with the defaults of ath11k_wmi_start_scan_init). The results come back as WMI
+ * events on the control endpoint, so no data path is needed yet: SCAN (4) for progress and MGMT_RX (0x7001) for
+ * every beacon and probe response, whose SSID and BSSID we print.
+ */
+static void
+wifi_vdev_create(void)
+{
+	static uint32_t m[4 + 10 + 1 + 8];
+	uint32_t *w = m;
+	memset(m, 0, sizeof(m));
+	w[0] = 0x5001;                                                  /* WMI_VDEV_CREATE_CMDID */
+	w[1] = (0x5au << 16) | 36u;                                     /* WMI_TAG_VDEV_CREATE_CMD */
+	w[2] = 0;                                                       /* vdev_id */
+	w[3] = 2;                                                       /* WMI_VDEV_TYPE_STA */
+	w[4] = 0;                                                       /* subtype none */
+	memcpy(&w[5], g_htc.mac, 4);
+	memcpy(&w[6], g_htc.mac + 4, 2);
+	w[7] = 2;                                                       /* num_cfg_txrx_streams */
+	w[8] = 0;                                                       /* pdev_id */
+	w[11] = (0x13u << 16) | 32u;                                    /* ARRAY_STRUCT, two stream configs */
+	uint32_t chains = g_htc.rf_chains ? g_htc.rf_chains : 2u;
+	w[12] = (0x19fu << 16) | 12u; w[13] = 0; w[14] = chains; w[15] = chains;        /* 2.4 GHz */
+	w[16] = (0x19fu << 16) | 12u; w[17] = 1; w[18] = chains; w[19] = chains;        /* 5 GHz */
+	printf("SWEET WMI: vdev 0 create (station, MAC %02x:%02x:%02x:%02x:%02x:%02x)\n", g_htc.mac[0], g_htc.mac[1],
+	    g_htc.mac[2], g_htc.mac[3], g_htc.mac[4], g_htc.mac[5]);
+	htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)m, 4 * 20);
+}
+
+static void
+wifi_scan(void)
+{
+	wifi_vdev_create();
+	volatile int settle = 0;
+	(void)wifi_wait(&settle, 300, "after vdev create");
+	static uint32_t m[1 + 40 + 1 + 1 + 3 + 1];
+	uint32_t *w = m;
+	memset(m, 0, sizeof(m));
+	w[0] = 0x3001;                                                  /* WMI_START_SCAN_CMDID */
+	uint32_t *c = w + 1;
+	c[0] = (0x51u << 16) | 156u;                                    /* WMI_TAG_START_SCAN_CMD */
+	c[1] = 0xa000;                                                  /* scan_id */
+	c[2] = 1;                                                       /* scan_req_id */
+	c[3] = 0;                                                       /* vdev_id */
+	c[4] = 4;                                                       /* scan_priority: low */
+	c[5] = 0x1 | 0x2 | 0x4 | 0x8 | 0x10;                            /* started, completed, bss/foreign chan, dequeued */
+	c[6] = 50;                                                      /* dwell_time_active */
+	c[7] = 150;                                                     /* dwell_time_passive */
+	c[8] = 50;                                                      /* min_rest_time */
+	c[9] = 500;                                                     /* max_rest_time */
+	c[13] = 20000;                                                  /* max_scan_time */
+	c[14] = 5;                                                      /* probe_delay */
+	c[15] = 0x2 | 0x10;                                             /* bcast probe request, channel stats */
+	c[17] = 0;                                                      /* num_chan: all of them */
+	c[18] = 1;                                                      /* num_bssid */
+	c[19] = 0;                                                      /* num_ssids */
+	c[36] = 0;                                                      /* dwell_time_active_2g */
+	c[37] = 40; c[38] = 30;                                         /* 6 GHz dwell times */
+	uint32_t *t = c + 40;
+	t[0] = (0x11u << 16);                                           /* ARRAY_UINT32: no channel list */
+	t[1] = (0x14u << 16);                                           /* ARRAY_FIXED_STRUCT: no SSIDs */
+	t[2] = (0x14u << 16) | 8u;                                      /* ARRAY_FIXED_STRUCT: one BSSID */
+	t[3] = 0xffffffffu; t[4] = 0x0000ffffu;                         /* broadcast */
+	t[5] = (0x12u << 16);                                           /* ARRAY_BYTE: no extra IEs */
+	printf("SWEET WMI: scan start (all channels, broadcast probe)\n");
+	htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)m, 4 * 47);
+	if (wifi_wait(&g_htc.scan_done, 25000, "scan") == 0) {
+		printf("SWEET WIFI: SCAN COMPLETE, %u frames from access points\n", g_htc.aps);
+	}
+	volatile int never = 0;
+	(void)wifi_wait(&never, 2000, "after scan");
+}
+
+#define RC(field, value)        cfg[field] = (value)
 static void
 wmi_init(void)
 {
@@ -1213,8 +1327,12 @@ wmi_init(void)
 		return;
 	}
 	printf("SWEET WMI: FIRMWARE UP (WMI ready)\n");
-	volatile int never = 0;
-	(void)wifi_wait(&never, 3000, "after WMI ready");
+	if (g_step >= 15) {
+		wifi_scan();
+	} else {
+		volatile int never = 0;
+		(void)wifi_wait(&never, 3000, "after WMI ready");
+	}
 }
 
 static int
-- 
2.43.0

