index 555309a..3e2c8c8 100644
--- a/bsd/dev/apollo_pcie.c
+++ b/bsd/dev/apollo_pcie.c
@@ -3710,6 +3710,28 @@ mhi_probe(void)
 	printf("SWEET MHI: serial %#x sbl-arb %#x numseg %u hwid %x %x %x %x\n", rd(g_bar, bhi + 0x40),
 	    rd(g_bar, bhi + 0x44), rd(g_bar, bhi + 0x48), rd(g_bar, bhi + 0x4c), rd(g_bar, bhi + 0x50),
 	    rd(g_bar, bhi + 0x54), rd(g_bar, bhi + 0x58));
+	/*
+	 * What the chip looks like before anything of ours has touched it, printed identically in both
+	 * passes so the two can be read side by side. k43 says the second instance asserts at line 367 of a
