+				0x01e03140, 0x01e0313c,
+			};
+			for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i += 2) {
+				printf("SWEET PCIE: chip (pass %u) %#09x = %#010x   %#09x = %#010x\n", g_pass,
+				    regs[i], win_rd(regs[i]), regs[i + 1], win_rd(regs[i + 1]));
+			}
+		}
+	}
