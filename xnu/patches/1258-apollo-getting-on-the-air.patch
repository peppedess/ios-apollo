+/*
+ * Wi-Fi phase 5: getting on the air.
+ *
+ * Everything so far has been listening. To talk we need four things, in this order, and the firmware's own
+ * command table gives the shape of each: the vdev started on the access point's channel (0x5003, a 116-byte
+ * wmi_vdev_start_request_cmd followed by one wmi_channel, tag 0x050, exactly as the scan channel list wanted
+ * them), a peer for the access point (0x6001, tag 0x061 — vdev_id, the address and a peer type), and then the
+ * management frames themselves (0x7008, tag 0x1a6: vdev, a descriptor id we choose, the channel, the physical
+ * address of the frame, its length, and the first bytes of it inline).
+ *
+ * The tag numbering holds up all the way through. 0x050 is wmi_channel because record 0x4002, set channel, is
+ * nothing but one of them, and record 0x4006, set WMM parameters, is a 12-byte command followed by four
+ * 28-byte wmi_wmm_params — which is what the standard enum says sits at 0x053 and 0x054. Counting on from
+ * there lands peer_create at 0x061 and peer_assoc at 0x065, and the table agrees: 0x6005 is a 248-byte
+ * command followed by a 24-byte vht_rate_set, which is peer_assoc_complete down to the byte.
+ */
+static vm_offset_t g_mgmt_va;
+static uint64_t g_mgmt_pa;
+static uint32_t g_mgmt_desc = 0x1000;
+
+static int
+wifi_mgmt_buf(void)
+{
+	if (g_mgmt_va) {
+		return 0;
+	}
+	if (sweet_gpu_pool_alloc(0x1000, &g_mgmt_pa) != 0 || g_mgmt_pa + 0x1000 > 0x100000000ull) {
+		printf("SWEET WIFI: no pool for the management buffer\n");
+		return -1;
+	}
+	if (!(g_mgmt_va = ml_io_map((vm_offset_t)g_mgmt_pa, 0x1000))) {
+		printf("SWEET WIFI: the management buffer would not map\n");
+		return -1;
+	}
+	printf("SWEET WIFI: management buffer at %#llx\n", g_mgmt_pa);
+	return 0;
+}
+
+static void
+wifi_vdev_start(uint32_t freq)
+{
+	static uint32_t m[40];
+	uint32_t *w = m;
+	memset(m, 0, sizeof(m));
+	w[0] = 0x5003;                                                  /* WMI_VDEV_START_REQUEST_CMDID */
+	w[1] = (0x058u << 16) | 112u;                                   /* WMI_TAG_VDEV_START_REQUEST_CMD */
+	w[2] = 0;                                                       /* vdev_id */
+	w[3] = 0;                                                       /* requestor_id */
+	w[4] = 100;                                                     /* beacon_interval, in TU */
+	w[5] = 1;                                                       /* dtim_period */
+	w[6] = 0;                                                       /* flags: not a restart, not hidden */
+	/* w[7] is ssid_len and w[8..15] the SSID: a station's own vdev does not carry one */
+	w[19] = 0;                                                      /* disable_hw_ack */
+	w[20] = 3;                                                      /* preferred_tx_chain_mask: both chains */
+	w[21] = 3;                                                      /* preferred_rx_chain_mask */
+	uint32_t *c = w + 30;
+	c[0] = (0x050u << 16) | 24u;                                    /* WMI_TAG_CHANNEL */
+	c[1] = freq;                                                    /* mhz */
+	c[2] = freq;                                                    /* band_center_freq1, 20 MHz */
+	c[3] = 0;
+	c[4] = 5u | (1u << 11);                                         /* MODE_11NG_HT20, HT allowed */
+	c[5] = (20u << 8) | (20u << 16);
+	c[6] = (20u << 8);
+	w[37] = (0x12u << 16);
+	w[38] = (0x12u << 16);
+	w[39] = (0x12u << 16);
+	g_htc.vdev_started = 0;
+	printf("SWEET WMI: vdev 0 start on %u MHz\n", freq);
+	htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)m, sizeof(m));
+	if (wifi_wait(&g_htc.vdev_started, 3000, "vdev start") != 0) {
+		printf("SWEET WMI: no answer to the vdev start\n");
+	}
+}
+
+static void
+wifi_peer_create(const uint8_t *bssid)
+{
+	static uint32_t m[7];
+	uint32_t *w = m;
+	memset(m, 0, sizeof(m));
+	w[0] = 0x6001;                                                  /* WMI_PEER_CREATE_CMDID */
+	w[1] = (0x061u << 16) | 16u;                                    /* WMI_TAG_PEER_CREATE_CMD */
+	w[2] = 0;                                                       /* vdev_id */
+	memcpy(&w[3], bssid, 4);
+	memcpy(&w[4], bssid + 4, 2);
+	w[4] &= 0xffffu;
+	w[5] = 0;                                                       /* WMI_PEER_TYPE_DEFAULT */
+	w[6] = (0x12u << 16);                                           /* the trailing array, empty */
+	printf("SWEET WMI: peer %02x:%02x:%02x:%02x:%02x:%02x create\n", bssid[0], bssid[1], bssid[2], bssid[3],
+	    bssid[4], bssid[5]);
+	htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)m, sizeof(m));
+	volatile int settled = 0;
+	(void)wifi_wait(&settled, 200, "after peer create");
+}
+
+static void
+wifi_mgmt_tx(const uint8_t *frame, uint32_t len, uint32_t freq)
+{
+	if (wifi_mgmt_buf() != 0 || len > 0x800) {
+		return;
+	}
+	for (uint32_t i = 0; i < len; i++) {
+		*(volatile uint8_t *)(g_mgmt_va + i) = frame[i];
+	}
+	uint32_t inline_len = len > 64u ? 64u : len;
+	uint32_t pad = (inline_len + 3u) & ~3u;
+	static uint32_t m[2 + 10 + 1 + 16 + 1 + 2 + 1];
+	uint32_t *w = m;
+	memset(m, 0, sizeof(m));
+	w[0] = 0x7008;                                                  /* WMI_MGMT_TX_SEND_CMDID */
+	w[1] = (0x1a6u << 16) | 40u;                                    /* WMI_TAG_MGMT_TX_SEND_CMD */
+	w[2] = 0;                                                       /* vdev_id */
+	w[3] = ++g_mgmt_desc;                                           /* desc_id, echoed in the completion */
+	w[4] = freq;                                                    /* chanfreq */
+	w[5] = (uint32_t)g_mgmt_pa;                                     /* paddr_lo */
+	w[6] = (uint32_t)(g_mgmt_pa >> 32);                             /* paddr_hi */
+	w[7] = len;                                                     /* frame_len */
+	w[8] = inline_len;                                              /* buf_len, what follows inline */
+	w[9] = 0;                                                       /* tx_params_valid */
+	w[10] = 0;                                                      /* tx_flags */
+	w[11] = 0;                                                      /* peer_rssi */
+	w[12] = (0x11u << 16) | inline_len;                             /* ARRAY_BYTE: the head of the frame */
+	memcpy(&w[13], frame, inline_len);
+	uint32_t *t = w + 13 + pad / 4u;
+	t[0] = (0x284u << 16) | 8u;                                     /* wmi_tx_send_params, all zero */
+	t[3] = (0x12u << 16);
+	uint32_t total = (uint32_t)((t + 4) - w) * 4u;
+	printf("SWEET WIFI: sending %u bytes of management frame on %u MHz (desc %u)\n", len, freq, w[3]);
+	htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)m, total);
+}
+
+static uint32_t
+wifi_mgmt_hdr(uint8_t *f, uint32_t subtype, const uint8_t *bssid)
+{
+	f[0] = (uint8_t)(subtype << 4);                                 /* type 0, management */
+	f[1] = 0;
+	f[2] = 0; f[3] = 0;                                             /* duration */
+	memcpy(f + 4, bssid, 6);                                        /* addr1: the access point */
+	memcpy(f + 10, g_htc.mac, 6);                                   /* addr2: us */
+	memcpy(f + 16, bssid, 6);                                       /* addr3: the BSS */
+	f[22] = 0; f[23] = 0;                                           /* sequence control, the firmware fills it */
+	return 24;
+}
+
+static void
+wifi_join(void)
+{
+	/*
+	 * Pick the loudest network that is not a Wi-Fi Direct group. DIRECT- names belong to a phone or a PC
+	 * acting as a group owner — scheggia's own is the loudest thing in the room at −37 dBm — and joining
+	 * one needs a P2P negotiation we are nowhere near.
+	 */
+	uint32_t best = WIFI_MAX_NETS;
+	for (uint32_t i = 0; i < g_nnets; i++) {
+		if (!g_net_ssid[i][0] || strncmp(g_net_ssid[i], "DIRECT-", 7) == 0) {
+			continue;
+		}
+		if (best == WIFI_MAX_NETS || g_net_rssi[i] > g_net_rssi[best]) {
+			best = i;
+		}
+	}
+	if (best == WIFI_MAX_NETS) {
+		printf("SWEET WIFI: nothing to join\n");
+		return;
+	}
+	uint32_t freq = 2412u + 5u * (g_net_chan[best] - 1u);
+	printf("SWEET WIFI: joining \"%s\" at %02x:%02x:%02x:%02x:%02x:%02x, channel %u (%u MHz), %d dBm\n",
+	    g_net_ssid[best], g_nets[best][0], g_nets[best][1], g_nets[best][2], g_nets[best][3],
+	    g_nets[best][4], g_nets[best][5], g_net_chan[best], freq, g_net_rssi[best]);
+	wifi_vdev_start(freq);
+	wifi_peer_create(g_nets[best]);
+	/*
+	 * Open-system authentication: algorithm 0, sequence 1, status 0. WPA2 does its real work later, in the
+	 * four-way handshake, and the authentication frame itself is the same six bytes it has been since 1997.
+	 * If the access point answers with sequence 2 and status 0, this radio is transmitting.
+	 */
+	uint8_t frame[64];
+	memset(frame, 0, sizeof(frame));
+	uint32_t o = wifi_mgmt_hdr(frame, 11, g_nets[best]);
+	frame[o + 0] = 0; frame[o + 1] = 0;                             /* open system */
+	frame[o + 2] = 1; frame[o + 3] = 0;                             /* transaction sequence 1 */
+	frame[o + 4] = 0; frame[o + 5] = 0;                             /* status */
+	g_htc.auth_resp = 0;
+	wifi_mgmt_tx(frame, o + 6, freq);
+	if (wifi_wait(&g_htc.auth_resp, 3000, "authentication") != 0) {
+		printf("SWEET WIFI: no authentication response\n");
+		return;
+	}
+	if (g_htc.auth_status != 0) {
+		printf("SWEET WIFI: authentication refused, status %u\n", g_htc.auth_status);
+		return;
+	}
+	printf("SWEET WIFI: AUTHENTICATED\n");
+}
+
 /*
  * Wi-Fi phase 4b: the HAL data-path rings, which ath11k builds (ath11k_dp_alloc, ath11k_dp_pdev_reo_setup)
  * before it ever sends WMI_INIT, and which we had skipped. k13d showed the firmware sitting happily for 15 s
