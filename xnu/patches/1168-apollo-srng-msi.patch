+/*
+ * Every ring ath11k sets up carries an MSI address and data (HAL_SRNG_FLAGS_MSI_INTR), so a completion is
+ * delivered as a write the hardware itself retires. We drive the rings by polling and programmed none, which
+ * leaves each ring's interrupt asserted into the WCSS aggregate status with nobody to clear it — and the
+ * aggregate status is what the firmware's light-sleep sequence waits on before it can collapse the domain.
+ * Point them all at the same scratch page; nothing reads it.
+ */
+static void
+srng_msi(uint32_t r0, uint32_t data)
+{
+	uint64_t a = g_mpa + MSI_LAND;
+	win_wr(r0 + 0x48, (uint32_t)a);
+	win_wr(r0 + 0x4c, (uint32_t)((a >> 32) & 0xffu) | (1u << 8));
+	win_wr(r0 + 0x50, data);
+}
+
