+/*
+ * The networks heard during a scan. An access point beacons about ten times a second, so without this the
+ * log is the same four names over and over: k100 printed eight lines for five networks. Keep the addresses
+ * we have already named and print each one once.
+ */
+#define WIFI_MAX_NETS   24u
+static uint8_t g_nets[WIFI_MAX_NETS][6];
+static char g_net_ssid[WIFI_MAX_NETS][33];
+static uint8_t g_net_chan[WIFI_MAX_NETS];
+static int8_t g_net_rssi[WIFI_MAX_NETS];
+static uint32_t g_nnets;
+
 static uint32_t
 ring_next(uint32_t off, uint32_t base, uint32_t n)
 {
@@ -1689,8 +1701,27 @@ htc_rx(uint32_t pipe, const uint8_t *p, uint32_t n)
 				}
 			}
 			g_htc.aps++;
-			printf("SWEET WIFI: AP %02x:%02x:%02x:%02x:%02x:%02x \"%s\" channel %u rssi %d (%u bytes)\n", bss[0],
-			    bss[1], bss[2], bss[3], bss[4], bss[5], ssid, chan, rssi, buflen);
+			uint32_t known = WIFI_MAX_NETS;
+			for (uint32_t i = 0; i < g_nnets; i++) {
+				if (memcmp(g_nets[i], bss, 6) == 0) {
+					known = i;
+					break;
+				}
+			}
+			if (known < WIFI_MAX_NETS) {
+				/* already named: keep the best signal we have heard from it and say nothing */
+				if ((int8_t)rssi > g_net_rssi[known]) {
+					g_net_rssi[known] = (int8_t)rssi;
+				}
+			} else if (g_nnets < WIFI_MAX_NETS) {
+				memcpy(g_nets[g_nnets], bss, 6);
+				strlcpy(g_net_ssid[g_nnets], ssid, sizeof(g_net_ssid[0]));
+				g_net_chan[g_nnets] = (uint8_t)chan;
+				g_net_rssi[g_nnets] = (int8_t)rssi;
+				g_nnets++;
+				printf("SWEET WIFI: AP %02x:%02x:%02x:%02x:%02x:%02x \"%s\" channel %u rssi %d (%u bytes)\n", bss[0],
+				    bss[1], bss[2], bss[3], bss[4], bss[5], ssid, chan, rssi, buflen);
+			}
 		}
 		return;
 	}
