@@ -1060,6 +1060,7 @@ static uint32_t g_wlfw_node, g_wlfw_port;
  * one, and it decides the cal_done bit in the host capability and the mode we ask for.
  */
 static uint32_t g_pass = 1;
+static uint32_t g_restart;                              /* the calibration pass is done: cycle the chip and go again */
 static uint16_t g_txn = 1;
 static struct {
 	uint16_t want_id;
@@ -2628,9 +2629,20 @@ wifi_start(void)
 		g_nsaved = g_nseg < 4 ? g_nseg : 4;
 		g_reuse = 0;
 		g_nseg = 0;
-		ath11k_sw_reset();
-		pc_msleep(100);
-		mhi_probe();
+		/*
+		 * And hand the restart to pcie_main rather than doing it here. sweetsoftpass=1 goes back to the
