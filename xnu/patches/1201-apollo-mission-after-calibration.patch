diff --git a/bsd/dev/apollo_pcie.c b/bsd/dev/apollo_pcie.c
index 0029de4..554802f 100644
--- a/bsd/dev/apollo_pcie.c
+++ b/bsd/dev/apollo_pcie.c
@@ -2534,8 +2534,45 @@ wifi_start(void)
 		}
 		if (!g_q.caldone) {
 			printf("SWEET WLFW: calibration did not finish, mhistatus %#x\n", rd(g_bar, 0x48));
+			return;
+		}
+		/*
+		 * And now the pass the chip has been waiting for since the first run.
+		 *
+		 * cnss2 ends the calibration pass with mode OFF(4) and then tears the chip all the way down —
+		 * MHI POWER_OFF and DEINIT, WLAN_EN low, all five rails off — before bringing it up again for
+		 * mission with cal_done 1 in its host capability. We cannot replay that from here without
+		 * re-running the whole PCIe and MHI bring-up, so try the cheap version first: mode OFF, then the
+		 * ini sync and wlan_cfg that belong to mission, then mode MISSION(0), in this one session.
+		 *
+		 * If the firmware accepts the transition we are in mission mode on a calibrated radio and the
+		 * WMI path below runs for the first time on a chip that is actually ready. If it refuses, we
+		 * will know the power cycle is load-bearing and can go and build it. sweetcalthen=0 stops after
+		 * the calibration, as k27 did.
+		 */
+		uint32_t cont = 1;
+		(void)PE_parse_boot_argn("sweetcalthen", &cont, sizeof(cont));
+		if (!cont) {
+			return;
+		}
+		uint8_t off[] = { 0x01, 4, 0, 4, 0, 0, 0,  0x10, 1, 0, 0 };
+		if (wlfw_req(0x22, off, sizeof(off), "wlan_mode off") != 0) {
+			return;
+		}
+		printf("SWEET WLFW: calibration pass closed, arming mission mode\n");
+		uint32_t ini2 = 1;
+		(void)PE_parse_boot_argn("sweetini", &ini2, sizeof(ini2));
+		if (ini2) {
+			const uint8_t inireq[] = { 0x10, 1, 0, 1 };
+			(void)wlfw_req(0x2f, inireq, sizeof(inireq), "wlan_ini");
+		}
+		if (wlfw_req(0x23, t, o, "wlan_cfg") != 0) {
+			return;
+		}
+		uint8_t miss[] = { 0x01, 4, 0, 0, 0, 0, 0,  0x10, 1, 0, 0 };
+		if (wlfw_req(0x22, miss, sizeof(miss), "wlan_mode mission") != 0) {
+			return;
 		}
-		return;
 	}
 	printf("SWEET WLFW: mission mode on\n");
 
