diff --git a/bsd/dev/apollo_pcie.c b/bsd/dev/apollo_pcie.c
index 554802f..889db13 100644
--- a/bsd/dev/apollo_pcie.c
+++ b/bsd/dev/apollo_pcie.c
@@ -2555,9 +2555,20 @@ wifi_start(void)
 		if (!cont) {
 			return;
 		}
-		uint8_t off[] = { 0x01, 4, 0, 4, 0, 0, 0,  0x10, 1, 0, 0 };
-		if (wlfw_req(0x22, off, sizeof(off), "wlan_mode off") != 0) {
-			return;
+		/*
+		 * k28 says mode OFF is exactly what we must not send. The firmware took it — result 0, error 0 —
+		 * and then stopped answering QMI altogether: wlan_ini and wlan_cfg both timed out at 5000 ms.
+		 * OFF tears the service down, which is fine for cnss2 because it is about to cut the power
+		 * anyway, and fatal for us because we are staying in the same session. sweetcaloff=1 sends it
+		 * again for anyone who wants to see that happen.
+		 */
+		uint32_t sendoff = 0;
+		(void)PE_parse_boot_argn("sweetcaloff", &sendoff, sizeof(sendoff));
+		if (sendoff) {
+			uint8_t off[] = { 0x01, 4, 0, 4, 0, 0, 0,  0x10, 1, 0, 0 };
+			if (wlfw_req(0x22, off, sizeof(off), "wlan_mode off") != 0) {
+				return;
+			}
 		}
 		printf("SWEET WLFW: calibration pass closed, arming mission mode\n");
 		uint32_t ini2 = 1;
