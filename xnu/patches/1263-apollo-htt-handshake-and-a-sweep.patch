+/*
+ * The vdev start, and a sweep over what we are unsure of.
+ *
+ * k103, k105 and k106 all came back with status 0xffffffff from three different commands: the first with
+ * three preferred streams, the second with two, the third with the per-band stream configuration the vdev
+ * had been missing and ath11k's own phymode and LDPC flag. Three refusals that look identical mean the
+ * refusal probably has nothing to do with the contents, but "probably" has cost us four runs already, and
+ * a whole sweep costs about a tenth of a second. Each variant goes out, waits for its answer, and prints
+ * it; the first one the firmware accepts wins and the rest are skipped.
+ */
+struct vdev_start_variant {
+	const char *what;
+	uint32_t mode, flags, bcn, streams, requestor;
+};
