+static int
+wifi_vdev_start_sweep(uint32_t freq)
+{
+	static const struct vdev_start_variant vs[] = {
+		{ "HE20_2G, LDPC, 2 streams",  21, 1u << 3, 100, 2, 0 },
+		{ "11NG_HT20 + ALLOW_HT",       5u | (1u << 11), 0, 100, 2, 0 },
+		{ "11G",                         1, 0, 100, 2, 0 },
+		{ "HE20_2G, no flags",          21, 0, 100, 2, 0 },
+		{ "HE20_2G, one stream",        21, 1u << 3, 100, 1, 0 },
+		{ "HE20_2G, no beacon interval", 21, 1u << 3, 0, 2, 0 },
+		{ "HE20_2G, requestor 1",       21, 1u << 3, 100, 2, 1 },
+		{ "11AC_VHT20_2G",              11, 1u << 3, 100, 2, 0 },
+	};
+	for (uint32_t i = 0; i < sizeof(vs) / sizeof(vs[0]); i++) {
+		wifi_vdev_start(freq, &vs[i]);
+		printf("SWEET WMI:   [%s] -> status %u\n", vs[i].what, g_htc.vdev_start_status);
+		if (g_htc.vdev_start_status == 0) {
+			printf("SWEET WMI: VDEV STARTED with [%s]\n", vs[i].what);
+			return 0;
+		}
+		if (g_sysfail) {
+			return -1;
+		}
+	}
+	return -1;
+}
