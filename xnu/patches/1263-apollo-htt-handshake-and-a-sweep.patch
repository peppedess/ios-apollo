+/*
+ * The HTT version request, which ath11k sends the moment WMI says it is ready and before it registers a
+ * single radio with mac80211 (ath11k_dp_tx_htt_h2t_ver_req_msg, called from ath11k_core_start between
+ * ath11k_wmi_wait_for_unified_ready and ath11k_mac_register). It is four bytes — message type 0 — on the
+ * HTT endpoint, and the firmware answers with a version confirmation. We have had that endpoint connected
+ * since the very first run and have never said a word on it.
+ *
+ * This matters here because a vdev is not only a radio: it is also a data path, and a firmware that has
+ * not agreed an HTT version with the host has no data path to attach one to. It is the best remaining
+ * explanation for a vdev start that comes back −1 whatever we put in the command.
+ */
+static void
+wifi_htt_version(void)
+{
+	uint32_t m[1] = { 0 };                                          /* HTT_H2T_MSG_TYPE_VERSION_REQ */
+	printf("SWEET HTT: version request on endpoint %u\n", g_htc.htt_eid);
+	htc_send(&g_ce4, g_htc.htt_eid, (const uint8_t *)m, sizeof(m));
+	volatile int settled = 0;
+	(void)wifi_wait(&settled, 300, "after the HTT version request");
+}
