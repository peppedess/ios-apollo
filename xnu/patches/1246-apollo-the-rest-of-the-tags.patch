diff --git a/bsd/dev/apollo_pcie.c b/bsd/dev/apollo_pcie.c
index e978457..22a8119 100644
--- a/bsd/dev/apollo_pcie.c
+++ b/bsd/dev/apollo_pcie.c
@@ -1694,11 +1694,16 @@ static void wifi_scan(void);
 static void
 wifi_vdev_create(void)
 {
-	static uint32_t m[4 + 10 + 1 + 8];
+	static uint32_t m[4 + 10 + 1 + 8 + 1];
 	uint32_t *w = m;
 	memset(m, 0, sizeof(m));
 	w[0] = 0x5001;                                                  /* WMI_VDEV_CREATE_CMDID */
-	w[1] = (0x5au << 16) | 36u;                                     /* WMI_TAG_VDEV_CREATE_CMD */
+	/*
+	 * Tag 0x56, not 0x5a: the firmware's own command table (0x15a9490, record for id 0x5001) says
+	 * WMI_VDEV_CREATE takes a 40-byte struct tagged 0x056 followed by two ARRAY_STRUCTs, of 16-byte and
+	 * 12-byte elements. The size we had was right; only the tag was from the wrong ath11k.
+	 */
+	w[1] = (0x56u << 16) | 36u;                                     /* WMI_TAG_VDEV_CREATE_CMD */
 	w[2] = 0;                                                       /* vdev_id */
 	w[3] = 2;                                                       /* WMI_VDEV_TYPE_STA */
 	w[4] = 0;                                                       /* subtype none */
@@ -1707,12 +1712,14 @@ wifi_vdev_create(void)
 	w[7] = 2;                                                       /* num_cfg_txrx_streams */
 	w[8] = 0;                                                       /* pdev_id */
 	w[11] = (0x12u << 16) | 32u;                                    /* ARRAY_STRUCT, two stream configs */
+	/* and the second array the table asks for, with nothing in it */
 	uint32_t chains = g_htc.rf_chains ? g_htc.rf_chains : 2u;
 	w[12] = (0x19fu << 16) | 12u; w[13] = 0; w[14] = chains; w[15] = chains;        /* 2.4 GHz */
 	w[16] = (0x19fu << 16) | 12u; w[17] = 1; w[18] = chains; w[19] = chains;        /* 5 GHz */
 	printf("SWEET WMI: vdev 0 create (station, MAC %02x:%02x:%02x:%02x:%02x:%02x)\n", g_htc.mac[0], g_htc.mac[1],
 	    g_htc.mac[2], g_htc.mac[3], g_htc.mac[4], g_htc.mac[5]);
-	htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)m, 4 * 20);
+	w[20] = (0x12u << 16);
+	htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)m, 4 * 21);
 }
 
 static void
@@ -1721,12 +1728,17 @@ wifi_scan(void)
 	wifi_vdev_create();
 	volatile int settle = 0;
 	(void)wifi_wait(&settle, 300, "after vdev create");
-	static uint32_t m[1 + 40 + 1 + 1 + 3 + 1];
+	static uint32_t m[1 + 40 + 10];
 	uint32_t *w = m;
 	memset(m, 0, sizeof(m));
 	w[0] = 0x3001;                                                  /* WMI_START_SCAN_CMDID */
 	uint32_t *c = w + 1;
-	c[0] = (0x51u << 16) | 156u;                                    /* WMI_TAG_START_SCAN_CMD */
+	/*
+	 * Tag 0x4d, not 0x51, and eight trailing TLVs rather than four. The table's record for 0x3001 reads
+	 * 0x04d/160, then 0x010, 0x013, 0x013, 0x011, 0x012, 0x011, 0x013, 0x013 — so the ones we were
+	 * leaving out are not optional padding, they are part of the shape the parser walks.
+	 */
+	c[0] = (0x4du << 16) | 156u;                                    /* WMI_TAG_START_SCAN_CMD */
 	c[1] = 0xa000;                                                  /* scan_id */
 	c[2] = 1;                                                       /* scan_req_id */
 	c[3] = 0;                                                       /* vdev_id */
@@ -1750,8 +1762,12 @@ wifi_scan(void)
 	t[2] = (0x13u << 16) | 8u;                                      /* ARRAY_FIXED_STRUCT: one BSSID */
 	t[3] = 0xffffffffu; t[4] = 0x0000ffffu;                         /* broadcast */
 	t[5] = (0x11u << 16);                                           /* ARRAY_BYTE: no extra IEs */
+	t[6] = (0x12u << 16);
+	t[7] = (0x11u << 16);
+	t[8] = (0x13u << 16);
+	t[9] = (0x13u << 16);
 	printf("SWEET WMI: scan start (all channels, broadcast probe)\n");
-	htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)m, 4 * 47);
+	htc_send(&g_ce3, g_htc.wmi_eid, (const uint8_t *)m, 4 * 51);
 	if (wifi_wait(&g_htc.scan_done, 25000, "scan") == 0) {
 		printf("SWEET WIFI: SCAN COMPLETE, %u frames from access points\n", g_htc.aps);
 	}
