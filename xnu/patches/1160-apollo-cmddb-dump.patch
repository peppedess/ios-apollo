+/*
+ * List every cmd-db resource, so a name that does not resolve can be told from a name this board simply
+ * does not have. apollo's cnss node asks for "smpf2" (PM8009 S2, vdd-wlan-dig) and our lookup finds no
+ * match for it: either the board really lacks it or we are reading only part of the dictionary.
+ */
+int sweet_rpmh_dump(void);
+
+int
+sweet_rpmh_dump(void)
+{
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_map();
+	if (error == 0) {
+		for (unsigned i = 0; i < 8; ++i) {
+			uint32_t h = 8u + 16u * i;
+			unsigned slave = rh_db16(h);
+			if (!slave) {
+				break;
+			}
+			uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+			unsigned count = rh_db16(h + 6);
+			printf("SWEET RPMH: header %u: slave %u, %u entries at %#x\n", i, slave, count, entries);
+			char line[200];
+			unsigned n = 0;
+			for (unsigned j = 0; j < count; ++j) {
+				uint32_t e = entries + RH_DB_ENTRY * j;
+				if (!rh_range(e, RH_DB_ENTRY)) {
+					break;
+				}
+				char nm[9];
+                                uint32_t k0 = rh_read(rh_db, e), k1 = rh_read(rh_db, e + 4);
+				for (unsigned c = 0; c < 4; ++c) {
+					nm[c] = (char)(k0 >> (8u * c));
+					nm[4 + c] = (char)(k1 >> (8u * c));
+				}
+				nm[8] = 0;
+				for (unsigned c = 0; c < 8; ++c) {
+					if (nm[c] == 0) {
+						break;
+					}
+					if (nm[c] < 32 || nm[c] > 126) {
+						nm[c] = '?';
+					}
+				}
+				n += (unsigned)snprintf(line + n, sizeof(line) - n, "%s=%#x ", nm,
+				    rh_read(rh_db, e + 16));
+				if (n > 150 || j + 1 == count) {
+					printf("SWEET RPMH:   %s\n", line);
+					n = 0;
+					line[0] = 0;
+				}
+			}
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
