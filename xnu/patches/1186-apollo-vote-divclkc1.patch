+++ b/bsd/dev/apollo_pcie.c
@@ -3176,6 +3176,19 @@ pcie_main(void *arg __unused, wait_result_t w __unused)
 	vote_clk("lnbclka1");
 	vote_clk("lnbclka2");
 	vote_clk("lnbclka3");
+	/*
+	 * And the one clock resource on this board we had never voted. cmd-db's slave-4 table holds exactly
+	 * eight clock-ish names — rfclka1, rfclka3, rfclkd3, rfclkd4, lnbclka1..3 — plus divclkc1 at 0x45b00.
+	 * On Qualcomm PMICs a divclk output is the divided 32.768 kHz sleep clock, and the sleep clock is what
+	 * a PMU state machine counts on to sequence a power collapse. The firmware dies waiting for the WCSS
+	 * domain to go down and nothing the host *says* changes it, so what the chip *has* is what is left.
+	 * sweetdivclk=0 drops it again.
+	 */
+	uint32_t divclk = 1;
+	(void)PE_parse_boot_argn("sweetdivclk", &divclk, sizeof(divclk));
+	if (divclk) {
+		vote_clk("divclkc1");
+	}
