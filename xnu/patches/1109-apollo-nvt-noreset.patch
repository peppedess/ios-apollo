From 040748987f6470f15e3b9ad489d26322e97727b4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 03:37:58 +0100
Subject: [PATCH] apollo 1109: nvtreset=0 reads the touch IC without resetting
 it

---
 bsd/dev/apollo_nvt.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/bsd/dev/apollo_nvt.c b/bsd/dev/apollo_nvt.c
index 46ccd1c..14738de 100644
--- a/bsd/dev/apollo_nvt.c
+++ b/bsd/dev/apollo_nvt.c
@@ -684,6 +684,22 @@ nv_thread(__unused void *arg, __unused wait_result_t wr)
 	if (!nv_se_init()) {
 		goto out;
 	}
+	/*
+	 * apollo 1109: nvtreset=0 first looks at the IC as the bootloader left it (no reset at all): the panel's
+	 * power-up may already have started the touch firmware (k3: after our bootloader reset, nothing started
+	 * it again and no firmware file exists on the phone).
+	 */
+	uint32_t do_reset = 1;
+	(void)PE_parse_boot_argn("nvtreset", &do_reset, sizeof(do_reset));
+	if (!do_reset) {
+		uint8_t st[5] = {0}, id[6] = {0};
+		(void)nv_read_addr(0x1f64e, id, sizeof(id));
+		(void)nv_read_addr(NV_EVENT_BUF | NV_MAP_RESET, st, sizeof(st));
+		printf("APOLLO NVT: untouched IC: id %02x %02x %02x %02x %02x %02x, reset state %02x %02x %02x %02x %02x\n",
+		    id[0], id[1], id[2], id[3], id[4], id[5], st[0], st[1], st[2], st[3], st[4]);
+		nv_fw_info();
+		goto run;
+	}
 	/* Probe order of nvt_ts_probe: reset low, eng reset, reset high, 10 ms, chip id. */
 	nv_gpio(nv.south, NV_PIN_RESET, 0, 0, 0, true, false);
 	delay(1000);
@@ -705,6 +721,7 @@ nv_thread(__unused void *arg, __unused wait_result_t wr)
 		goto out;
 	}
 	nv_fw_info();
+run:
 	printf("APOLLO NVT: touch running (poll %u ms, edge latch on GPIO %u)\n", poll, NV_PIN_IRQ);
 	uint8_t d[NV_POINT_LEN];
 	unsigned idle = 0;
-- 
2.43.0

